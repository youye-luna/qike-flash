      <Shortcut destination="Startmenu" name="齐刻 Qike Flash" targetFile="&lt;InstallPath&gt;\multi-burn.exe" commandLineArguments="" iconFilePath="&lt;InstallPath&gt;\multi-burn.exe" iconIndex="0"/>
    </Shortcuts>
    <Serials isDialogEnabled="false" count="1000" mask ="#####-#####-#####-#####"/>
    <SplashScreen isDialogEnabled="false" delayTime="2">
      <Image filePath=""/>
      <Sound isEnabled="false" filePath=""/>
    </SplashScreen>
    <License isDialogEnabled="false">
      <Data>e1xydGYxXGFuc2lcYW5zaWNwZzkzNlxkZWZmMFxub3VpY29tcGF0XGRlZmxhbmcxMDMzXGRlZmxhbmdmZTIwNTJ7XGZvbnR0Ymx7XGYwXGZuaWwgQXJpYWw7fX0NCntcKlxnZW5lcmF0b3IgUmljaGVkMjAgMTAuMC4yNjEwMH1cdmlld2tpbmQ0XHVjMSANClxwYXJkXGYwXGZzMjBcbGFuZzIwNTJccGFyDQp9DQoA</Data>
    </License>
    <Finish isRebootMachineEnabled="false">
      <Program executableFilePath="&lt;InstallPath&gt;\multi-burn.exe" arguments="" isLaunchEnabled="true"/>
